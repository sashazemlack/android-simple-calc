<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Exchange Rate screen (Exchange flavor only) -->
    <string name="exch_from">変換元</string>
    <string name="exch_to">変換先</string>
    <string name="exch_swap">入れ替え</string>
    <string name="exch_swap_description">通貨を入れ替え</string>
    <string name="exch_pick_from">変換元の通貨</string>
    <string name="exch_pick_to">変換先の通貨</string>
    <string name="exch_search_placeholder">通貨名またはコードで検索</string>
    <string name="exch_search_empty">一致する通貨はありません</string>
    <!-- %1$s = formatted amount, %2$s = currency name, e.g. "Amount: 12.5 Euro" -->
    <string name="exch_amount_description">金額：%1$s %2$s</string>
    <!-- %1$s = formatted converted amount, %2$s = currency name, e.g. "Converted amount: 13.91 US Dollar" -->
    <string name="exch_result_description">換算後の金額：%1$s %2$s</string>
    <string name="exch_result_unavailable">換算後の金額を表示できません</string>
    <!-- %1$s = data source, e.g. "Source: central bank and other official rates blended by frankfurter.dev" -->
    <string name="exch_attribution">%1$s · クロスレートは端末上で計算</string>
    <!-- Compact layout: both unit rates on one line, e.g. "1 EUR = 1.1127 USD · 1 USD = 0.898715 EUR" -->
    <string name="exch_rate_pair">%1$s · %2$s</string>
    <!-- Rate line of the selected pair when its rate is older than the newest rates.
         %1$s = rate line, e.g. "1 EUR = 1.9949 ANG", %2$s = date of that rate, e.g. "11 Nov 2026" -->
    <string name="exch_rate_dated">%1$s（%2$s時点）</string>

    <!-- Pull-to-refresh and manual refresh -->
    <string name="exch_refreshing_indicator">為替レートを更新しています</string>
    <string name="exch_refresh_action">為替レートを更新</string>
    <string name="exch_feedback_updated">為替レートを更新しました</string>
    <string name="exch_feedback_failed">為替レートを更新できませんでした</string>

    <!-- Status block above the keypad. Templates receive one formatted date or time as %1$s. -->
    <string name="exch_status_loading">為替レートを読み込んでいます…</string>
    <string name="exch_status_refreshing">為替レートを更新しています…</string>
    <!-- %1$s = download date and time, e.g. "12 Nov 2026, 10:15" -->
    <string name="exch_status_fresh">為替レートの最終更新：%1$s</string>
    <string name="exch_status_cached">保存済みのレートを使用中 · 最終更新：%1$s</string>
    <string name="exch_status_stale">保存済みのレートを使用中（古い可能性があります） · 最終更新：%1$s</string>
    <string name="exch_status_unavailable">為替レートを取得できません。下にスワイプして再試行してください。</string>
    <string name="exch_status_last_updated">最終更新：%1$s</string>
    <!-- %1$s = newest date of the downloaded rates (provider date, not the download time), e.g. "12 Nov 2026" -->
    <string name="exch_status_rate_date">%1$sの為替レート</string>
    <!-- Same for rates published by the European Central Bank (fallback source), e.g. "ECB reference rates of 11 Nov 2026" -->
    <string name="exch_status_rate_date_ecb">%1$sの欧州中銀参照レート</string>
    <string name="exch_status_update_failed">更新できませんでした。下にスワイプして再試行してください。</string>
    <!-- Joins two parts of the status detail line,
         e.g. "Exchange rates of 12 Nov 2026 · Update failed. Swipe down to retry." -->
    <string name="exch_status_joined">%1$s · %2$s</string>
    <string name="exch_error_no_connection">インターネットに接続されていません。</string>
    <string name="exch_error_server">為替レートサービスは現在利用できません。</string>
    <string name="exch_error_invalid_data">為替レートサービスから無効なデータが返されました。</string>
    <!-- Data sources (shown before "· cross rates calculated on device"). Keep "frankfurter.dev" as is. -->
    <string name="exch_source_frankfurter_blended">出典：中央銀行などの公式レート（frankfurter.dev が集約）</string>
    <!-- Rates downloaded by earlier app versions (European Central Bank data via frankfurter.dev) -->
    <string name="exch_source_frankfurter">出典：欧州中央銀行（frankfurter.dev 経由）</string>
    <string name="exch_source_ecb">出典：欧州中央銀行</string>
</resources>
