<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Exchange Rate screen (Exchange flavor only) -->
    <string name="exch_from">From</string>
    <string name="exch_to">To</string>
    <string name="exch_swap">Swap</string>
    <string name="exch_swap_description">Swap currencies</string>
    <string name="exch_pick_from">Convert from</string>
    <string name="exch_pick_to">Convert to</string>
    <string name="exch_search_placeholder">Search currency or code</string>
    <string name="exch_search_empty">No matching currencies</string>
    <!-- %1$s = formatted amount, %2$s = currency name, e.g. "Amount: 12.5 Euro" -->
    <string name="exch_amount_description">Amount: %1$s %2$s</string>
    <!-- %1$s = formatted converted amount, %2$s = currency name, e.g. "Converted amount: 13.91 US Dollar" -->
    <string name="exch_result_description">Converted amount: %1$s %2$s</string>
    <string name="exch_result_unavailable">Converted amount unavailable</string>
    <!-- %1$s = data source, e.g. "Source: European Central Bank via frankfurter.dev" -->
    <string name="exch_attribution">%1$s · cross rates calculated on device</string>
    <!-- Compact layout: both unit rates on one line, e.g. "1 EUR = 1.1127 USD · 1 USD = 0.898715 EUR" -->
    <string name="exch_rate_pair">%1$s · %2$s</string>

    <!-- Pull-to-refresh and manual refresh -->
    <string name="exch_refreshing_indicator">Refreshing exchange rates</string>
    <string name="exch_refresh_action">Refresh exchange rates</string>
    <string name="exch_feedback_updated">Exchange rates updated</string>
    <string name="exch_feedback_failed">Couldn\'t refresh exchange rates</string>

    <!-- Status block above the keypad. Templates receive one formatted date or time as %1$s. -->
    <string name="exch_status_loading" tools:ignore="TypographyEllipsis">Loading exchange rates...</string>
    <string name="exch_status_refreshing" tools:ignore="TypographyEllipsis">Refreshing exchange rates...</string>
    <string name="exch_status_fresh">Rates last updated: %1$s</string>
    <string name="exch_status_cached">Using cached rates · Last updated: %1$s</string>
    <string name="exch_status_stale">Using cached rates (may be outdated) · Last updated: %1$s</string>
    <string name="exch_status_unavailable">Exchange rates unavailable. Swipe down to retry.</string>
    <string name="exch_status_last_updated">Last updated: %1$s</string>
    <string name="exch_status_rate_date">ECB reference rates of %1$s</string>
    <string name="exch_status_update_failed">Update failed. Swipe down to retry.</string>
    <string name="exch_error_no_connection">No internet connection.</string>
    <string name="exch_error_server">The exchange-rate service is not available right now.</string>
    <string name="exch_error_invalid_data">The exchange-rate service returned invalid data.</string>
    <string name="exch_source_frankfurter">Source: European Central Bank via frankfurter.dev</string>
    <string name="exch_source_ecb">Source: European Central Bank</string>
</resources>
