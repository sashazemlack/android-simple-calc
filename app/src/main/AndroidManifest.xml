<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared manifest. Deliberately declares NO permissions: the Offline flavor must not have
  network access. The Exchange flavor adds INTERNET in src/exchange/AndroidManifest.xml.
  RTL is disabled on purpose: the app is English-only and its keypads, tab underline and
  numeric expressions are laid out left-to-right (AppRoot also forces LayoutDirection.Ltr).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".CalcApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="false"
        android:theme="@style/Theme.SCalc"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Compose pulls in androidx.emoji2, whose startup initializer looks for the Google Play
          Services downloadable-font provider. Remove it so the apps never touch Play Services;
          the system emoji font is used instead (the UI shows no emoji anyway).
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
