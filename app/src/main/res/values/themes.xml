<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Plain platform window theme (no AppCompat, no Material Components). Compose draws the
      entire UI; this only sets the window background shown before the first frame.
    -->
    <style name="Theme.SCalc" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
